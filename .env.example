# ---- Mock toggle -------------------------------------------------------------
# true  = PageSpeed, GSC, DataForSEO, Twilio WhatsApp, Email and R2 use mocks (src/mocks)
# false = real API calls (needs the keys at the bottom of this file)
USE_MOCKS=true

# ---- Claude (REAL preferred) ------------------------------------------------
# If ANTHROPIC_API_KEY is set, the real Claude API is used.
# If it is empty (or MOCK_CLAUDE=true), a realistic mock JSON response is generated instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MOCK_CLAUDE=false

# ---- Postgres (Neon or Supabase) --------------------------------------------
# Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) string.
# connect_timeout=30 gives the free tier time to wake from auto-suspend (cold start).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# ---- Upstash Redis (BullMQ) ---------------------------------------------------
# Use the "rediss://" (TLS) URL from the Upstash console, NOT the REST URL
REDIS_URL="rediss://default:password@your-db.upstash.io:6379"

# ---- App / auth ---------------------------------------------------------------
# Public URL of the Next.js app (used in WhatsApp / email report links)
APP_URL=http://localhost:3000
# Random 32+ char string: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@edgelink.demo
ADMIN_PASSWORD=Admin@123
# Shared demo password for every client login (client logs in with their email)
CLIENT_PASSWORD=Client@123

# ---- Cron (cron-job.org) ------------------------------------------------------
# cron-job.org must send header:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-cron-secret
# Max audits processed inline by the cron route when no worker is online
CRON_INLINE_BATCH=1

# ---- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=1
# PORT is set automatically by Render/Railway (health endpoint)
PORT=8080

# ---- Real integrations (only used when USE_MOCKS=false) ----------------------
PAGESPEED_API_KEY=
GSC_ACCESS_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
RESEND_API_KEY=
EMAIL_FROM=reports@yourdomain.com
